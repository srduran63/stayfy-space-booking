# Copia este archivo como ".env" y rellena con los datos de tu proyecto Supabase
# (Project Settings -> API en https://app.supabase.com)
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU-ANON-KEY

# Único correo con acceso al Panel de Anfitrión (publicar/editar/eliminar espacios).
# Debe coincidir también con la RLS de supabase/schema.sql.
VITE_ADMIN_EMAIL=admin@example.com
